<!-- placeholder 必须要有：t-navbar 的 fixed 默认 true、placeholder 默认 false，
     不占位的话页面内容从 y=0 开始，顶部会被导航栏整块盖住（引擎条就是这么"消失"的） -->
<t-navbar title="AI 修图" left-arrow placeholder />

<!-- 引擎条是全局设置，必须常驻。.page 是「固定高 + overflow:auto」的滚动容器，
     引擎条放在里面会跟着内容一起滚走（滑到参数区再回来看，就像被删了），
     所以拆成两层：.shell 竖排（定高），.engine 和 .page（滚动区）是它的兄弟 -->
<view class="shell">
  <!-- ⓪ 引擎切换：混元单图快、Agnes 可加参考图但慢、Nexus 走 OpenAI 兼容网关，
       能力差异由 providers.js 定义。三个引擎后胶囊只摆名字，
       说明文案降为下一行（否则三个胶囊放不下一行） -->
  <view class="engine">
    <view class="engine__seg">
      <view
        wx:for="{{engines}}"
        wx:key="id"
        class="engine__item {{engineId === item.id ? 'engine__item--on' : ''}}"
        data-id="{{item.id}}"
        bindtap="chooseEngine"
      >
        <text class="engine__name">{{item.name}}</text>
      </view>
    </view>
    <text class="engine__hint">{{engine.desc}} · {{engine.tip}}</text>
  </view>

  <view class="page">

    <!-- ① 预览区：原图 / 对比 / 结果 三态共用一块，图按比例完整显示 -->
    <view class="stage">
      <view class="stage__head">
        <view wx:if="{{resultSrc}}" class="stage__tabs">
          <view
            class="stage__tab {{stageView === 'src' ? 'stage__tab--on' : ''}}"
            data-view="src"
            bindtap="switchView"
          >
            原图
          </view>
          <view
            class="stage__tab {{stageView === 'both' ? 'stage__tab--on' : ''}}"
            data-view="both"
            bindtap="switchView"
          >
            对比
          </view>
          <view
            class="stage__tab {{stageView === 'out' ? 'stage__tab--on' : ''}}"
            data-view="out"
            bindtap="switchView"
          >
            结果
          </view>
        </view>
        <text wx:else class="stage__title">原图</text>

        <view class="stage__actions">
          <text wx:if="{{sourcePath && engine.maxImages === 1}}" class="stage__link" bindtap="chooseImage">更换</text>
          <text wx:if="{{sourcePath && engine.maxImages > 1 && canAddImage}}" class="stage__link" bindtap="chooseImage">添加</text>
          <text wx:if="{{sourcePath}}" class="stage__meta">
            <text wx:if="{{engine.maxImages > 1}}">{{imageCount}}/{{engine.maxImages}} · </text>{{outputLabel}}
          </text>
        </view>
      </view>

      <view class="stage__box {{sourcePath ? '' : 'stage__box--empty'}}">
        <!-- 并排对比：两张同时看，各自等比缩小、完整展示 -->
        <view wx:if="{{stageView === 'both' && resultSrc && sourcePath}}" class="pair">
          <view class="pair__col" data-view="src" bindtap="tapStage">
            <text class="pair__tag">原图</text>
            <view class="pair__card">
              <image class="pair__img" src="{{sourcePath}}" mode="aspectFit" />
            </view>
          </view>
          <view class="pair__gap"></view>
          <view class="pair__col" data-view="out" bindtap="tapStage">
            <text class="pair__tag pair__tag--out">结果</text>
            <view class="pair__card">
              <image class="pair__img" src="{{resultSrc}}" mode="aspectFit" />
            </view>
          </view>
        </view>

        <image
          wx:elif="{{stageView === 'out' && resultSrc}}"
          class="stage__img"
          src="{{resultSrc}}"
          mode="aspectFit"
          data-view="out"
          bindtap="tapStage"
        />
        <image
          wx:elif="{{sourcePath}}"
          class="stage__img"
          src="{{sourcePath}}"
          mode="aspectFit"
          data-view="src"
          bindtap="tapStage"
        />

        <view wx:else class="stage__empty" bindtap="chooseImage">
          <t-icon name="add" size="64rpx" color="#00000026" />
          <text class="stage__empty-title">{{engine.maxImages > 1 ? '先选一张主图' : '从相册选择一张照片'}}</text>
          <text class="stage__empty-tip">{{engine.emptyTip}}</text>
        </view>

        <view wx:if="{{uploading}}" class="stage__mask">上传中…</view>
        <view wx:if="{{generating}}" class="stage__mask">{{engine.waitText}}…</view>
      </view>

      <!-- 多图素材槽：混元只有 1 张，这里不渲染；Agnes 最多 4 张，第 1 张是主图 -->
      <view wx:if="{{engine.maxImages > 1 && imageCount > 0}}" class="slots">
        <view
          wx:for="{{images}}"
          wx:key="fileID"
          class="slot"
          data-index="{{index}}"
          bindtap="previewSlot"
        >
          <image class="slot__img" src="{{item.path}}" mode="aspectFill" />
          <text class="slot__tag {{item.isMain ? 'slot__tag--main' : ''}}">{{item.label}}</text>
          <view class="slot__del" data-index="{{index}}" catchtap="removeImageAt">×</view>
        </view>
        <view wx:if="{{canAddImage}}" class="slot slot--add" bindtap="chooseImage">
          <t-icon name="add" size="40rpx" color="#00000040" />
          <text class="slot__add-tip">加参考</text>
        </view>
      </view>

      <!-- 出图后的操作，只在有结果时出现 -->
      <view wx:if="{{resultSrc}}" class="stage__ops">
        <view class="ops__btn" bindtap="saveToAlbum">保存相册</view>
        <view class="ops__btn" bindtap="useAsSource">继续修改</view>
        <view class="ops__btn ops__btn--ghost" bindtap="previewCurrent">大图</view>
      </view>
    </view>

    <!-- ② 锁定不换：图生图最容易翻车的是 AI 顺着提示词把人和场景一起重画。
         点整块开关，点右侧笔改文案；class / icon 都在 JS 侧算好 -->
    <view class="locks">
      <view class="locks__head" bindtap="toggleLocksPanel">
        <view class="locks__head-left">
          <t-icon name="{{lockHeaderIcon}}" size="28rpx" color="{{lockHeaderColor}}" />
          <text class="locks__title">{{lockTitle}}</text>
          <text class="locks__summary">{{lockSummary}}</text>
        </view>
        <view class="locks__setting">
          <text class="locks__hint-text">{{locksExpanded ? '收起' : '设置'}}</text>
          <t-icon name="chevron-{{locksExpanded ? 'up' : 'down'}}" size="24rpx" color="#00000066" />
        </view>
      </view>

      <view wx:if="{{locksExpanded}}" class="locks__grid">
        <view wx:for="{{locks}}" wx:key="id" class="{{item.cls}}">
          <view class="lock__main" data-id="{{item.id}}" bindtap="toggleLock">
            <t-icon name="{{item.icon}}" size="26rpx" color="{{item.iconColor}}" />
            <view class="lock__text">
              <view class="lock__name-row">
                <text class="lock__name">{{item.name}}</text>
                <text wx:if="{{item.hasMark}}" class="lock__mark">{{item.mark}}</text>
                <text wx:if="{{item.mandatory}}" class="lock__required">必选</text>
              </view>
              <text class="lock__desc">{{item.desc}}</text>
            </view>
          </view>
          <view wx:if="{{!item.mandatory}}" class="lock__edit" data-id="{{item.id}}" catchtap="openLockEditor">
            <t-icon name="edit" size="22rpx" color="#00000040" />
          </view>
        </view>
      </view>

      <text wx:if="{{locksExpanded}}" class="locks__hint">五官保护固定开启，其余项目可自由调整</text>
      <text wx:if="{{lockTip}}" class="{{lockTipCls}}">{{lockTip}}</text>
    </view>

    <!-- ③ 常用效果优先，手动参数按需展开 -->
    <view class="tech">
      <view class="tech__top">
        <view class="step-head">
          <text class="step-title">修图设置</text>
        </view>
        <view class="tech__tools">
          <text wx:if="{{hasPicked}}" class="tech__reset" catchtap="resetSelection">清空</text>
        </view>
      </view>
      <view class="effects">
        <view class="effects__head">
          <view class="effects__intro">
            <text class="effects__title">快捷效果</text>
          </view>
          <text class="effects__count" catchtap="toggleEffects">{{effectsExpanded ? '收起' : '更多'}}</text>
        </view>
        <scroll-view class="effects__list" scroll-y show-scrollbar="{{true}}">
          <view
            wx:for="{{visibleEffectRecommendations}}"
            wx:key="id"
            class="{{item.cls}}"
            data-id="{{item.id}}"
            bindtap="chooseEffectRecommendation"
          >
            <view class="effect__copy">
              <text class="effect__name">{{item.name}}</text>
              <text class="effect__desc">{{item.desc}}</text>
            </view>
            <t-icon wx:if="{{item.selected}}" name="check" size="30rpx" color="#0052d9" />
          </view>
        </scroll-view>
      </view>

      <view class="tech__advanced-toggle" bindtap="toggleParams">
        <text class="tech__advanced-title">手动微调</text>
        <text class="tech__count">{{pickedDigits}}</text>
        <text class="tech__expand">{{paramsExpanded ? '收起' : '展开'}}</text>
      </view>

      <view wx:if="{{paramsExpanded}}">
        <view class="seg">
          <view
            wx:for="{{cats}}"
            wx:key="id"
            class="seg__item {{activeCatId === item.id ? 'seg__item--on' : ''}}"
            data-id="{{item.id}}"
            bindtap="chooseCategory"
          >
            <t-icon
              name="{{item.icon}}"
              size="36rpx"
              color="{{activeCatId === item.id ? '#0052d9' : '#00000080'}}"
            />
            <view class="seg__label">
              <text class="seg__name">{{item.name}}</text>
              <text wx:if="{{item.badge}}" class="seg__badge">{{item.badge}}</text>
            </view>
          </view>
        </view>

      <view wx:if="{{activeCat}}" class="tech__body">
        <!-- 每个参数都显示名称、下拉当前值和对应的优化说明 -->
        <view class="dims">
          <view wx:for="{{dimensions}}" wx:key="key" class="dim">
            <view class="dim__head">
              <text class="dim__name">{{item.name}}</text>
            </view>

            <picker
              mode="selector"
              range="{{item.options}}"
              range-key="label"
              value="{{item.pickedIndex}}"
              data-key="{{item.key}}"
              bindchange="chooseDimensionOption"
            >
              <view class="dim__picker">
                <text class="dim__value">{{item.pickedLabel}}</text>
                <t-icon name="chevron-down" size="30rpx" color="#777" />
              </view>
            </picker>
            <text class="dim__desc">{{item.pickedDesc}}</text>

          </view>
        </view>

      </view>
      </view>
    </view>

    <!-- ④ 指令：AI 效果与参数建议分开，避免一个入口承担两种任务 -->
    <view class="clip">
      <text class="clip__label">这次怎么改</text>
      <text class="clip__digits">{{promptDigits}}</text>
      <view class="clip__advice-group">
        <view class="clip__advice" data-mode="effect" catchtap="openAdvice">
          <text class="clip__advice-text">效果推荐</text>
        </view>
        <view class="clip__advice" data-mode="parameter" catchtap="openAdvice">
          <text class="clip__advice-text">参数推荐</text>
        </view>
      </view>
      <text wx:if="{{promptPreview}}" class="clip__more" catchtap="openPrompt">查看 ›</text>
    </view>
  </view>
</view>

<!-- ⑤ 底部操作栏 -->
<view class="dock">
  <view wx:if="{{error}}" class="dock__error">
    <t-icon class="dock__error-icon" name="error-circle" size="28rpx" color="#d54941" />
    <text class="dock__error-text">{{error}}</text>
    <view
      wx:if="{{errorRetryable && !generating && !uploading}}"
      class="dock__error-retry"
      bindtap="retryGenerate"
    >
      重试
    </view>
  </view>
  <view class="dock__row">
    <!-- 只是个摘要条：点开进弹层写。写整段提示词和「补一句」都走这里 -->
    <view class="dock__field {{extra ? 'dock__field--filled' : ''}}" bindtap="openPromptInput">
      <text class="dock__field-text">{{extra || '选因素，或点这里自己写提示词'}}</text>
      <text wx:if="{{extra}}" class="dock__field-len">{{extraDigits}}</text>
    </view>
    <!-- 因素全留「不指定」也能出图（按原图重新出片），所以只看有没有图，不看选了几项 -->
    <view class="dock__go {{imageCount && !generating && !uploading ? '' : 'dock__go--off'}}">
      <t-button
        theme="primary"
        size="medium"
        icon="lightbulb"
        loading="{{generating}}"
        disabled="{{generating || uploading || !imageCount}}"
        bindtap="generate"
        t-class="dock__btn"
      >
        生成成片
      </t-button>
    </view>
  </view>
</view>

<!-- ⑥ 指令拆解弹层 -->
<view wx:if="{{promptOpen}}" class="mask" bindtap="closePrompt">
  <view class="sheet" catchtap="noop">
    <view class="sheet__head">
      <text class="sheet__title">这次怎么改</text>
      <text class="sheet__copy" bindtap="copyPrompt">复制</text>
    </view>
    <scroll-view class="sheet__body" scroll-y>
      <view wx:if="{{hasPicked}}" class="picked">
        <text wx:for="{{pickedTags}}" wx:key="key" class="picked__tag">{{item.text}}</text>
      </view>
      <view wx:for="{{promptParts}}" wx:key="key" class="part">
        <text class="part__key">{{item.key}}</text>
        <text class="part__text">{{item.text}}</text>
      </view>
    </scroll-view>
    <view class="sheet__foot">{{promptFoot}}</view>
    <!-- 提示词版本与来源：云端热更新后这里会变成「v2 · 云端」，用来确认真的换上了 -->
    <view class="sheet__ver">{{promptNote}}</view>
  </view>
</view>

<!-- ⑦ AI 建议弹层：按效果方向或参数微调给出 3 条可追加的指令 -->
<view wx:if="{{adviceOpen}}" class="mask" bindtap="closeAdvice">
  <view class="sheet" catchtap="noop">
    <view class="sheet__head">
      <text class="sheet__title">{{adviceTitle}}</text>
      <view class="sheet__acts">
        <text wx:if="{{adviceFromCache}}" class="sheet__cache">上次结果</text>
        <text class="sheet__copy" catchtap="refreshAdvice">{{advising ? '想想…' : '换一批'}}</text>
      </view>
    </view>

    <view wx:if="{{advice && advice.analysis}}" class="advice__analysis">{{advice.analysis}}</view>

    <scroll-view class="sheet__body" scroll-y>
      <view wx:if="{{advising}}" class="advice__hint">AI 正在分析图片和当前提示词…</view>
      <view wx:if="{{adviceError}}" class="advice__hint advice__hint--error">{{adviceError}}</view>
      <view
        wx:for="{{advice && advice.candidates}}"
        wx:key="text"
        class="advice"
        data-index="{{index}}"
        bindtap="pickAdvice"
      >
        <view class="advice__tag">{{item.label}}</view>
        <text class="advice__text">{{item.text}}</text>
      </view>
    </scroll-view>

    <view class="sheet__foot">{{adviceApplyHint}}</view>
  </view>
</view>

<!-- ⑧ 自己写提示词：不选任何因素也能在这里写完整描述 -->
<view wx:if="{{promptInputOpen}}" class="mask" style="{{inputSheetStyle}}" bindtap="closePromptInput">
  <view class="sheet" catchtap="noop">
    <view class="sheet__head">
      <text class="sheet__title">自己写提示词</text>
      <view class="sheet__acts">
        <text wx:if="{{promptDraft}}" class="sheet__copy" catchtap="clearDraft">清空</text>
        <text class="sheet__copy sheet__copy--primary" catchtap="applyDraft">完成</text>
      </view>
    </view>

    <textarea
      class="input-area"
      value="{{promptDraft}}"
      placeholder="想怎么拍就怎么写：场景、光线、色调、镜头、人物状态都行"
      placeholder-class="input-area__ph"
      maxlength="-1"
      auto-height
      show-confirm-bar="{{false}}"
      adjust-position="{{false}}"
      cursor-spacing="24"
      bindinput="onDraftInput"
      bindkeyboardheightchange="onInputKeyboard"
    />

    <view class="input-foot">
      <text class="input-foot__tip">不选因素就只按这段描述生成；选了因素会拼在因素后面</text>
      <text class="input-foot__count">{{draftDigits}}</text>
    </view>
  </view>
</view>

<!-- ⑨ 编辑锁定文案：这段话会原样写进提示词最后，可加「保留脸上的痣」这类具体要求 -->
<view wx:if="{{lockEditorOpen}}" class="mask" style="{{inputSheetStyle}}" bindtap="closeLockEditor">
  <view class="sheet" catchtap="noop">
    <view class="sheet__head">
      <text class="sheet__title">编辑「{{lockEditName}}」锁定</text>
      <view class="sheet__acts">
        <text wx:if="{{lockDraftEdited}}" class="sheet__copy" catchtap="resetLockDraft">恢复默认</text>
        <text class="sheet__copy sheet__copy--primary" catchtap="applyLockDraft">完成</text>
      </view>
    </view>

    <textarea
      class="input-area"
      value="{{lockDraft}}"
      placeholder="写清楚哪些不能变，越具体越能约束住 AI"
      placeholder-class="input-area__ph"
      maxlength="-1"
      auto-height
      show-confirm-bar="{{false}}"
      adjust-position="{{false}}"
      cursor-spacing="24"
      bindinput="onLockDraftInput"
      bindkeyboardheightchange="onInputKeyboard"
    />

    <view class="input-foot">
      <text class="input-foot__tip">{{lockHint}}</text>
      <text class="input-foot__count">{{lockDraftDigits}}</text>
    </view>
  </view>
</view>

<t-toast id="t-toast" />
