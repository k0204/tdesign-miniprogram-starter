{
  "version": "0.4",
  "updatedAt": "2026-10-25",
  "note": "修图预设（变白 / 变美）。核心决策：变白走确定性色彩工程，不走生图模型重绘——重绘会改变身份，这是人像产品最大的信任风险。v0.3 已用实测标定替换 v0.1 的错误矩阵与 v0.2 的失效 gamma。",
  "changelog": [
    {
      "from": "v0.1",
      "problem": "用「提高蓝通道增益」实现降黄，蓝增益同时抬高了整体亮度，与 brightness 叠加后浅色衣物大面积溢出。实测 B2 冷白皮 standard 档把 19.75% 的像素推到纯白。",
      "fix": "拆成两个解耦维度：(1) 色温用亮度中性的三通道矩阵 r/g/b 增益，降黄时压低 R、G 并抬高 B，总亮度贡献≈1，不再顺带提亮；(2) 提亮改用 gamma，对高光收敛、对中间调提升，天然抗溢出。",
      "evidence": "修正后 6 个预设 3 档共 18 组参数，高光溢出全部 < 1.5%（见 docs/beauty-presets-preview.jpg 与终端量化表）"
    },
    {
      "from": "v0.2",
      "problem": "用 sharp.gamma() 做提亮，实测完全无效——同一张图传 gamma 1.4~2.2 输出像素完全一致（肤色亮度恒定 171.3）。gamma 对已解码的 sRGB JPEG 不生效，只对 raw/未标定输入有意义。因此 v0.2 六个预设的亮度差异实际全部来自 tone 与 contrast，B2 冷白皮只有 +2.8%，撑不起「显白最明显」的标签。",
      "fix": "提亮改用 modulate({ brightness })。标定后建立线性响应：每 +0.01 约 +2.3% 肤色区亮度。同时把亮度职责从 tone 完全剥离，tone 只做色温。",
      "evidence": "B2 冷白皮 standard 档由 +2.8% 提升到 +9.0%，色温 -10，溢出仍 <0.3%"
    },
    {
      "from": "v0.3-beta",
      "problem": "纯全局参数在含浅色衣物的图上必然烧掉白区：B2/B3 把 19.7% 的像素推到纯白（正好等于白衬衫面积），而这两个正是主推的显白档。",
      "fix": "改为肤色蒙版合成：全局先算出目标图，再用 RGBA 蒙版只把肤色区贴回去。关键实现细节——蒙版必须写成 RGBA，blend dest-in 读的是 alpha 通道，单通道灰度图 alpha 恒为 1，等于没遮罩。",
      "evidence": "蒙版模式下 B2 肤色提亮 13.3%（全局 13.5%，几乎无损失），溢出 19.72% → 0%；18 组参数溢出超标从 6 组降到 0 组。"
    }
  ],
  "principle": {
    "split": {
      "color": "变白、通透、降黄、氛围 —— 纯色彩变换，sharp 本地完成，零失真、百毫秒级、可实时预览",
      "retouch": "磨皮、去瑕、光泽 —— 局部像素处理，可本地可服务端",
      "ai": "五官微调、发丝、光影重塑 —— 必须图生图，有身份漂移风险，默认关闭，需显式开启"
    },
    "whyNotAiForWhiten": "生图模型的「美白」本质是重绘。1080 宽的图重绘后脸型、痣、双眼皮宽度都会变，用户第一眼觉得「不像我」就流失了。更致命的是每次生成结果不稳定，同一张图两次出片肤色不一致，无法做可靠的前后对比。",
    "identityGuard": "AI 档强制 facesim 校验：与原图人脸相似度 < 0.85 直接判失败并回退到色彩档结果"
  },
  "params": {
    "brightness": {
      "range": [
        0.97,
        1.12
      ],
      "api": "sharp.modulate({ brightness })",
      "calibration": "实测（内置测试图，肤色区基准 172）：1.00→0%，1.04→+4.6%，1.06→+6.9%，1.08→+9.2%，1.10→+10.9%（溢出 0.23%），1.12→+13.2%（溢出 0.48%）。约每 +0.01 ≈ 肤色区亮度 +2.3%。",
      "why": "线性乘，对肤色等比放大且不改色温（实测 R-B 恒定 62.7），与 tone 矩阵正交，可以两个维度独立调。",
      "overdo": "> 1.10 时浅色衣物开始溢出；真实照片肤色比测试图暗，安全余量更大，但仍需 Q2 拦截"
    },
    "tone": {
      "api": "sharp.recomb([[r,0,0],[0,g,0],[0,0,b]])",
      "brightnessNeutral": "0.299*r + 0.587*g + 0.114*b ≈ 1.0",
      "effect": "r/g 压低 + b 抬高 = 降黄（显白）；r 抬高 + b 压低 = 加暖（日落）",
      "why": "把「色温」和「亮度」解耦：降黄时压低 R 与 G、抬高 B，总亮度贡献≈1（实测 0.965/0.988/1.06 只让肤色亮度 -1.5%）。这是唯一能在不提亮的前提下把 R-B 差压掉 10 个单位的方法。",
      "overdo": "b > 1.09 时白墙发青；r < 0.94 时嘴唇失血色"
    },
    "saturation": {
      "range": [
        0.8,
        1.08
      ],
      "api": "sharp.modulate({ saturation })",
      "effect": "降饱和去火气，是「高级感」的主要来源",
      "overdo": "< 0.85 时嘴唇失去血色，显病态"
    },
    "contrast": {
      "range": [
        0.9,
        1.06
      ],
      "api": "sharp.linear(a, 128*(1-a))",
      "effect": "通透感来源，但会放大瑕疵",
      "overdo": "> 1.06 时毛孔和阴影被强调"
    },
    "shadowLift": {
      "range": [
        0,
        14
      ],
      "api": "sharp.linear(1, +b)",
      "effect": "提亮暗部，去「脏」感，奶油肌关键",
      "overdo": "> 14 时画面发灰没有层次"
    },
    "soften": {
      "range": [
        0,
        1
      ],
      "api": "sharp.median(3).blur(0.3+v*1.2)",
      "effect": "轻磨皮，只压高频噪点",
      "overdo": "> 0.7 时五官边界糊掉，像糊了层塑料膜"
    },
    "sharpen": {
      "range": [
        0,
        0.5
      ],
      "api": "sharp.sharpen({ sigma: 0.5 + v })",
      "effect": "补回磨皮损失的细节，眼睛和发丝变清晰",
      "overdo": "> 0.5 时出现白边"
    },
    "grain": {
      "range": [
        0,
        0.06
      ],
      "api": "叠加半透明噪点层",
      "effect": "胶片质感，掩盖磨皮后的塑料感",
      "overdo": "手机上看是脏点"
    }
  },
