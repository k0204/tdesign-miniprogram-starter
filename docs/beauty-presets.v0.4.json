  "skinProtection": {
    "needed": true,
    "why": "全局提亮/降黄必然烧掉浅色区。实测 B2 全局模式把 19.72% 的像素推到纯白，面积正好等于白衬衫；而 B2 恰恰是主推的显白档。",
    "maskRule": {
      "space": "HSL",
      "hueDeg": [
        8,
        42
      ],
      "sat": [
        0.15,
        0.55
      ],
      "light": [
        0.28,
        0.85
      ],
      "why": "l 上限必须压到 0.85：白衬衫 hsl 约 (h=41,s=0.21,l=0.89)，不压就会被当成肤色一起修"
    },
    "blend": {
      "skinWeight": 1,
      "bgWeight": 0.3,
      "why": "肤色满强度 + 非肤色 30% 弱补偿。只修脸会让「脸白了身子还黄」，画面割裂；给背景 30% 既统一色调又不至于把白衣服烧掉。",
      "impl": "蒙版写成 RGBA，alpha 在肤色区 = 255、非肤色区 = 76（255×0.3），羽化 blur 4px，用 blend dest-in 裁出处理后图再 over 回原图",
      "trap": "dest-in 读的是 alpha 通道。单通道灰度 PNG 的 alpha 恒为 1，合成等于没遮罩——这是最容易踩的一步。"
    },
    "measured": {
      "source": "tools/beauty-preset-preview.js / 18 组参数 / 内置测试图",
      "globalClipOverLimit": "6 / 18",
      "maskedClipOverLimit": "0 / 18",
      "skinLiftLoss": "13.5% → 13.4%，蒙版几乎不损失提亮效果"
    },
    "fallback": "蒙版覆盖率 < 6%（几乎无人像）时，跳过蒙版直接走全局参数，但把 brightness 与 tone.b 各衰减 50%"
  },
