  "ops": {
    "statusField": "online | draft | offline",
    "defaultSort": "sortWeight desc, createdAt desc",
    "fields": ["sortWeight", "status", "createdBy", "createdAt", "updatedAt"],
    "rules": [
      "新增条目只需填 theme/tone/main/sub，main 超过 9 字在保存时直接报错，不允许折行兜底",
      "同一 theme 下 main 的字符相似度 > 0.8 判重，避免上架一堆近义句",
      "每个 tone 至少保 4 条在线，低于 4 条时前端隐藏该语气 chip，不展示空列表",
      "下线用 status=offline 软删除，已有作品的引用仍可正常渲染"
    ]
